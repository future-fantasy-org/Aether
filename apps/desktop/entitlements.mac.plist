<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 JIT in renderer processes -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required by Electron's V8 pipeline -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Load unsigned native modules (node-pty) inside the sidecar node process -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- ELECTRON_RUN_AS_NODE sidecar depends on dyld env handling -->
    <key>com.apple.security.cs.allow-dyld-environment-variable</key>
    <true/>
  </dict>
</plist>
